      "cancel": {
        "q": "Can I cancel a ride?",
        "a": "Yes, as long as the passenger is not on board. Late cancellations may be reported to the other party."
      },
      "payment": {
        "q": "How do I pay?",
        "a": "Cash to the driver or by card through your wallet. Choose your default method in Settings."
      },
      "safety": {
        "q": "What safety measures are there?",
        "a": "Verified drivers, live trip sharing, SOS button and emergency contacts."
      },
      "carpool": {
        "q": "How do I book a carpool?",
        "a": "Carpool tab → Search a trip, choose the number of seats then book."
      },
      "lost": {
        "q": "I forgot an item",
        "a": "Open the ride in Activity then “Report a problem”: we will contact the driver."
      },
      "becomeDriver": {
        "q": "How do I become a driver?",
        "a": "Sign up as a driver and upload your documents. Approval usually takes 48 h."
      },
      "documents": {
        "q": "Which documents are required?",
        "a": "Driving licence, vehicle registration, valid insurance and ID card."
      },
      "counter": {
        "q": "What is a counter-offer?",
        "a": "If the offered price is too low, you can propose another amount to the passenger."
      },
      "earnings": {
        "q": "When do I get paid?",
        "a": "Cash is collected directly. Card payments are paid out every Monday."
      }
    }
